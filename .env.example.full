# .env 配置示例（已配置MSAL认证）

# =============================================================================
# Azure AD认证配置（必需）
# =============================================================================
# 用于通过MSAL获取访问令牌来调用LiteLLM proxy
#
# 配置步骤:
# 1. 在Azure Portal创建应用注册
# 2. 获取租户ID、客户端ID和客户端密钥
# 3. 配置API权限并授予管理员同意
# 详细步骤: 参考 QUICKSTART_MSAL.md

AZURE_TENANT_ID=12345678-1234-1234-1234-123456789abc
AZURE_CLIENT_ID=abcdefgh-abcd-abcd-abcd-abcdefghijkl
AZURE_CLIENT_SECRET=your-client-secret-value-here
AZURE_SCOPE=https://cognitiveservices.azure.com/.default


# =============================================================================
# LiteLLM Proxy配置（必需）
# =============================================================================
# LiteLLM proxy的基础URL和要使用的模型

LITELLM_BASE_URL=http://localhost:4000
LLM_MODEL=gpt-4

# 如果您的LiteLLM使用其他模型，可以修改:
# LLM_MODEL=gpt-4-turbo
# LLM_MODEL=claude-3-opus
# LLM_MODEL=azure/gpt-4


# =============================================================================
# Confluence MCP配置（必需）
# =============================================================================
# 通过LiteLLM调用的Confluence MCP模型名称

CONFLUENCE_MODEL=confluence-mcp

# 如果直接连接Confluence MCP（不通过LiteLLM），取消注释:
# CONFLUENCE_MCP_URL=http://confluence-mcp:8080/sse


# =============================================================================
# AWS S3配置（必需）
# =============================================================================
# 用于保存Confluence文档到S3存储桶

AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
S3_BUCKET=confluence-docs-backup


# =============================================================================
# Agent配置（可选）
# =============================================================================

# 搜索时返回的最大页面数量
SEARCH_LIMIT=10

# 日志级别: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO


# =============================================================================
# 开发配置（可选）
# =============================================================================

# 服务器配置
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000

# 是否启用调试模式
# DEBUG=false


# =============================================================================
# 注意事项
# =============================================================================
# 
# 1. 此文件包含敏感信息，不要提交到版本控制
# 2. 生产环境建议使用密钥管理服务（如Azure Key Vault）
# 3. 定期轮换Azure客户端密钥
# 4. 确保S3存储桶有适当的访问策略
# 5. 使用HTTPS保护传输中的数据
